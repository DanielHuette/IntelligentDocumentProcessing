# Copy to .env and fill in. Only the providers of the systems you run are required.

# Anthropic: Claude Haiku 5.5 and Claude Sonnet 5.5 (console: platform.claude.com)
ANTHROPIC_API_KEY=

# OpenAI: GPT-5.6 Luna and GPT-5.6 Terra
OPENAI_API_KEY=

# Cloudflare Workers AI: Jev, Llama, Mistral, DeepSeek
# Account ID from the dashboard URL; API token with "Workers AI: Edit".
# Jev is billed from AI Gateway credits, the other models from the Workers plan.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional limits
REQUEST_TIMEOUT_SECONDS=120
MAX_ATTEMPTS=4
